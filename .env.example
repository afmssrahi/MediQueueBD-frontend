# Copy to .env and edit as needed: `cp .env.example .env`
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time.
# After changing one, rebuild the image:
#   docker compose up --build

# mock = bundled demo database (no backend needed)
# live = call a real backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MODE=mock

# Only used when NEXT_PUBLIC_API_MODE=live.
# Inside Docker, "localhost" is the container itself — use the service name
# (e.g. http://backend:4000/api) or the host IP instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# The AI summary service — a separate backend that turns uploaded prescriptions
# and medical records into summaries, a patient history and literature
# references. It lives in ../ai-summary-prototype and listens on port 4100.
#
# Inside Docker, "localhost" is the container itself — use the service name
# (e.g. http://ai-summary:4100/api) or the host IP instead.
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:4100/api

# Host port that the app is published on.
PORT=3000
